{
  "name": "astrodc",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stop-dev.ps1",
    "dev:frontend": "npm --prefix frontend run serve",
    "dev:backend": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-backend.ps1 -Foreground",
    "build": "npm --prefix frontend run build",
    "build:backend": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/backend.ps1 -Task package",
    "test:frontend": "node scripts/test-frontend.cjs",
    "test:backend": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/backend.ps1 -Task test",
    "deploy": "node scripts/deploy-frontend.cjs"
  }
}
